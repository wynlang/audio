// Exercises the shipped lib in src/audio.wyn via the tests/audio.wyn symlink.
import audio

test "wav format" { assert_eq(audio.audio_format("song.wav"), "wav") }
test "mp3 format" { assert_eq(audio.audio_format("a.mp3"), "mp3") }
test "flac format" { assert_eq(audio.audio_format("a.flac"), "flac") }
test "unknown format" { assert_eq(audio.audio_format("a.txt"), "unknown") }
test "supported yes" { assert(audio.audio_is_supported("x.ogg")) }
test "supported no" { assert(not audio.audio_is_supported("x.txt")) }
test "bytes per second" { assert_eq(audio.audio_bytes_per_second(44100, 2, 16), 176400) }
test "duration estimate" { assert_eq(audio.audio_duration_estimate(352800, 176400), 2) }
test "duration zero guard" { assert_eq(audio.audio_duration_estimate(1000, 0), 0) }
